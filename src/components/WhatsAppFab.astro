---
import { site } from '../data/site';
import { dicts, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
---

<a class="wa" href={t(site.whatsapp, lang)} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.05-1.32A10 10 0 1 0 12 2zm-3.1 5.8h.55c.15.01.35-.06.54.41.2.49.68 1.7.74 1.82.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.24.25-.1.49.14.24.63 1.04 1.36 1.69.94.83 1.73 1.09 1.97 1.21.24.12.38.1.52-.06.14-.16.61-.71.77-.95.16-.24.33-.2.55-.12.22.08 1.43.67 1.67.79.24.12.4.18.46.28.06.11.06.6-.14 1.17-.21.58-1.21 1.13-1.66 1.17-.45.04-.87.2-2.94-.62-2.49-.98-4.07-3.52-4.19-3.68-.12-.16-.99-1.31-.99-2.5s.63-1.78.85-2.02c.22-.24.48-.3.64-.3z"
    ></path>
  </svg>
  <span class="wa__txt">{dict.waFab}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: clamp(1rem, 3vw, 2.2rem);
    bottom: clamp(1rem, 3vw, 2.2rem);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: .6rem;
    height: 4.4rem;
    padding: 0 1.2rem;
    border-radius: var(--r-pill);
    background: #25D366;
    color: #fff;
    font-weight: 600;
    font-size: .95rem;
    box-shadow: 0 10px 28px -8px rgba(37, 211, 102, .85), 0 2px 6px rgba(10, 24, 35, .18);
    transition: transform .4s var(--ease), box-shadow .4s var(--ease), background .3s;
  }

  .wa:hover {
    transform: scale(1.05) translateY(-3px);
    background: #1FBE5B;
    box-shadow: 0 18px 40px -10px rgba(37, 211, 102, .95);
  }

  .wa:active { transform: scale(.98) }

  .wa svg { width: 2rem; height: 2rem; flex: none; animation: waNudge 5s ease-in-out infinite }

  @keyframes waNudge {
    0%, 86%, 100% { transform: rotate(0) scale(1) }
    89% { transform: rotate(-14deg) scale(1.08) }
    92% { transform: rotate(12deg) scale(1.08) }
    95% { transform: rotate(-7deg) scale(1.04) }
  }

  /* El texto se despliega al pasar el mouse o enfocar */
  .wa__txt {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width .55s var(--ease), opacity .35s var(--ease);
  }

  .wa:hover .wa__txt, .wa:focus-visible .wa__txt { max-width: 12rem; opacity: 1 }

  /* Anillo que late alrededor del botón */
  .wa::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-pill);
    border: 2px solid #25D366;
    animation: ring 2.8s ease-out infinite;
    pointer-events: none;
  }

  @keyframes ring {
    0% { transform: scale(1); opacity: .65 }
    100% { transform: scale(1.35); opacity: 0 }
  }

  @media (max-width: 620px) {
    .wa { height: 4rem; padding: 0 1.05rem }
    .wa svg { width: 1.85rem; height: 1.85rem }
  }

  @media (max-width: 360px) {
    .wa { height: 3.6rem; padding: 0 .95rem }
    .wa svg { width: 1.7rem; height: 1.7rem }
  }
</style>
