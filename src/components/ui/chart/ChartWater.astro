---
/* Fondo de agua de carta: sondas (números de profundidad en itálica, como
   NOAA) y curvas batimétricas. Absoluto, detrás del contenido, aria-hidden.
   Las sondas son deterministas (seed fijo) para SSR estable. */
interface Props {
  class?: string;
  /** densidad de sondas */
  count?: number;
  seed?: number;
}
const { class: cls = '', count = 26, seed = 7 } = Astro.props;

/* PRNG determinista (mulberry32) — mismas sondas en cada build. */
function rng(s: number) {
  return () => {
    s |= 0; s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const soundings = Array.from({ length: count }, () => ({
  x: 3 + r() * 94,
  y: 4 + r() * 92,
  v: Math.round(2 + r() * 46),
  frac: r() > 0.72 ? Math.round(r() * 9) : null,
}));
---

<svg class={`chart-water ${cls}`} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
  {/* curvas batimétricas: contornos suaves que cruzan el campo */}
  <g fill="none" stroke="currentColor" opacity=".11">
    <path d="M-2,78 C 18,70 30,84 48,76 S 80,62 103,70" stroke-width=".18"></path>
    <path d="M-2,88 C 20,80 36,94 56,86 S 86,74 103,82" stroke-width=".18" stroke-dasharray=".5 .35"></path>
    <path d="M-2,26 C 14,32 30,20 50,25 S 84,34 103,28" stroke-width=".18" stroke-dasharray=".2 .3"></path>
  </g>
</svg>
<div class={`chart-soundings ${cls}`} aria-hidden="true">
  {
    soundings.map((s) => (
      <i style={`left:${s.x.toFixed(1)}%;top:${s.y.toFixed(1)}%`}>
        {s.v}
        {s.frac !== null && <sub>{s.frac}</sub>}
      </i>
    ))
  }
</div>

<style is:global>
  .chart-water {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    pointer-events: none;
  }

  .chart-soundings {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  /* Sondas: itálica serif pequeña, como los pies de agua de la carta */
  .chart-soundings i {
    position: absolute;
    font-family: var(--f-display);
    font-style: italic;
    font-size: .72rem;
    color: var(--ink);
    opacity: .34;
    letter-spacing: .02em;
  }

  .chart-soundings sub { font-size: .6em; margin-left: 1px }
</style>
