---
/* Gallardete (burgee) propio del taller: pennant triangular bicolor con
   franja de latón. La marca de sección del club. Decorativo (aria-hidden). */
interface Props {
  size?: string;
  class?: string;
}
const { size = '1.05rem', class: cls = '' } = Astro.props;
---

<svg class={`burgee ${cls}`} viewBox="0 0 44 24" style={`height:${size}`} aria-hidden="true">
  <path d="M1,1 L43,12 L1,23 Z" fill="var(--navy-2)" stroke="var(--brass)" stroke-width="1.4"></path>
  <path d="M1,1 L22,6.5 L22,17.5 L1,23 Z" fill="var(--burgee)"></path>
  <line x1="22" y1="6.5" x2="22" y2="17.5" stroke="var(--brass)" stroke-width="1.4"></line>
</svg>

<style is:global>
  .burgee { display: inline-block; vertical-align: -.14em; width: auto }
</style>
