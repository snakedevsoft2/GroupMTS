---
import type { ServiceIcon } from '@/data/services';

interface Props {
  icon: ServiceIcon;
}

const { icon } = Astro.props;
---

{
  icon === 'seat' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 11V8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3" />
      <path d="M2 13a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5H2z" />
      <path d="M5 18v2M19 18v2" />
    </svg>
  )
}
{
  icon === 'interior' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="6" rx="1.5" />
      <path d="M6.5 9v12M12 9v12M17.5 9v12" />
    </svg>
  )
}
{
  icon === 'enclosure' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M3 12h18M12 4v16" />
    </svg>
  )
}
{
  icon === 'top' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.5 13.5a9.5 9.5 0 0 1 19 0" />
      <path d="M2.5 13.5h19" />
      <path d="M6 13.5V21M18 13.5V21" />
    </svg>
  )
}
