---
import VideoBackdrop from '@/components/ui/VideoBackdrop.astro';
import { taller } from '@/data/site';
import { dicts, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
---

<section class="videoband">
  <VideoBackdrop src={taller.video} parallax="-.12" poster={taller.poster} />
  <div>
    <h2 class="reveal" data-d="1" set:html={t(taller.titleHtml, lang)} />
    <p class="lede reveal" data-d="2">{t(taller.lede, lang)}</p>
    <button class="play reveal" data-d="3" id="playBtn" aria-label={dict.playAria}>
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  /* Banda de mar profundo: el marino de la carta, sin luces de neón */
  .videoband {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(26rem, 60vh, 38rem);
    display: grid;
    place-items: center;
    text-align: center;
    padding: var(--section) var(--pad);
    background: var(--sea-2);
  }

  .videoband :global(.vbg) { background: linear-gradient(160deg, var(--sea), var(--sea-2)) }

  .videoband :global(.vbg::after) {
    background: linear-gradient(180deg, var(--sea-2), rgba(22, 44, 73, .66) 30%, rgba(22, 44, 73, .66) 70%, var(--sea-2));
  }

  .videoband :global(.grain) { opacity: .35 }

  .videoband h2 { max-width: 20ch; margin-inline: auto; color: var(--sea-ink) }
  .videoband h2 :global(em) { color: var(--land) }
  .videoband .lede { margin-inline: auto; color: var(--sea-muted) }

  .play {
    margin-top: 2.3rem;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: var(--r-s);
    display: grid;
    place-items: center;
    border: 1px solid rgba(220, 231, 237, .4);
    color: var(--sea-ink);
    background: rgba(220, 231, 237, .08);
    transition: .4s var(--ease);
  }

  .play:hover { background: var(--land); color: var(--sea-2); border-color: var(--land-2); transform: scale(1.05) }
  .play :global(svg) { width: 1.4rem; height: 1.4rem; margin-left: 3px }

  @media (max-height: 560px) and (orientation: landscape) {
    .videoband { min-height: auto }
  }
</style>

<script>
  /* Play / pause button for the shop video */
  const playBtn = document.getElementById('playBtn');
  playBtn?.addEventListener('click', () => {
    const video = playBtn.closest('.videoband')?.querySelector('video');
    if (!video) return;
    if (video.paused) {
      void video.play();
      playBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>';
    } else {
      video.pause();
      playBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    }
  });
</script>
