---
/* Línea de gallardetes del club: los oficios del taller izados en banda. */
import { marquee } from '@/data/site';
import { t, type Lang } from '@/i18n';
import Burgee from '@/components/ui/Burgee.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = marquee.map((item) => t(item, lang));
---

<div class="pennants" role="presentation">
  <div class="pennants__row">
    {
      items.map((label) => (
        <span class="pennants__item">
          <Burgee size=".85rem" />
          {label}
        </span>
      ))
    }
  </div>
</div>

<style>
  .pennants {
    border-block: 1px solid var(--brass-soft);
    background: var(--navy-2);
    padding: 1.15rem var(--pad);
  }

  .pennants__row {
    max-width: var(--maxw);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 2.4rem;
    align-items: center;
    justify-content: center;
  }

  .pennants__item {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--foam-muted);
    white-space: nowrap;
  }
</style>
