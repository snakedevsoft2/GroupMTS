---
/* Escala gráfica de la carta: la barra de millas náuticas con los oficios
   del taller rotulados entre marcas. Estática — la carta es papel quieto. */
import { marquee } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = marquee.map((item) => t(item, lang));
const unitLabel = lang === 'es' ? 'MILLAS NÁUTICAS' : 'NAUTICAL MILES';
---

<div class="scalebar" role="presentation">
  <div class="scalebar__wrap">
    <svg viewBox="0 0 600 14" aria-hidden="true" preserveAspectRatio="none">
      {Array.from({ length: 12 }, (_, i) => (
        <rect x={i * 50} y="4" width="50" height="6" fill={i % 2 ? 'none' : 'currentColor'} stroke="currentColor" stroke-width="1"></rect>
      ))}
      {Array.from({ length: 13 }, (_, i) => (
        <line x1={i * 50} y1="0" x2={i * 50} y2="14" stroke="currentColor" stroke-width="1"></line>
      ))}
    </svg>
    <div class="scalebar__row">
      <span class="scalebar__unit">0 — {unitLabel}</span>
      {items.map((label) => <span class="scalebar__item">{label}</span>)}
    </div>
  </div>
</div>

<style>
  .scalebar {
    border-block: 1px solid var(--line);
    background: var(--water-2);
    padding: 1.3rem var(--pad) 1.1rem;
  }

  .scalebar__wrap { max-width: var(--maxw); margin-inline: auto }

  .scalebar svg {
    display: block;
    width: 100%;
    height: 12px;
    color: var(--ink);
    opacity: .8;
  }

  .scalebar__row {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 2.2rem;
    margin-top: .7rem;
    align-items: baseline;
  }

  .scalebar__unit {
    font-size: .66rem;
    letter-spacing: .18em;
    color: var(--muted-strong);
    white-space: nowrap;
  }

  .scalebar__item {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(.95rem, 1.6vw, 1.15rem);
    color: var(--ink);
    white-space: nowrap;
  }
</style>
