---
/* El proceso como orden del club: actos numerados en romano, filete de latón. */
import { processHead, processSteps } from '@/data/process';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const roman = ['I', 'II', 'III', 'IV', 'V'];
---

<section class="section section--tint" id="proceso">
  <div class="wrap">
    <div class="head">
      <h2 class="reveal" data-d="1" set:html={t(processHead.titleHtml, lang)} />
    </div>
    <ol class="acts reveal" data-d="1">
      {
        processSteps.map((step, i) => (
          <li class="act">
            <span class="act__no">{roman[i]}</span>
            <h3>{t(step.title, lang)}</h3>
            <p>{t(step.text, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .acts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 2.2rem;
  }

  @media (min-width: 900px) {
    .acts { grid-template-columns: repeat(4, 1fr) }
  }

  .act { border-top: 1px solid var(--brass); padding-top: 1.2rem }

  .act__no {
    display: block;
    font-family: var(--f-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--brass-deep);
    margin-bottom: .9rem;
  }

  .act h3 { font-size: 1.05rem; margin-bottom: .55rem }
  .act p { font-size: .87rem; color: var(--muted-strong) }
</style>
