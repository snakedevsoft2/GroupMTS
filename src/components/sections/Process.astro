---
/* El proceso como derrota trazada: 4 waypoints sobre la línea de rumbo. */
import { processHead, processSteps } from '@/data/process';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const stageWord = lang === 'es' ? 'ETAPA' : 'LEG';
---

<section class="section section--tint" id="proceso">
  <div class="wrap">
    <div class="head">
      <h2 class="reveal" data-d="1" set:html={t(processHead.titleHtml, lang)} />
    </div>
    <ol class="route reveal" data-d="1">
      {
        processSteps.map((step, i) => (
          <li class="leg">
            <span class="leg__pt" aria-hidden="true"></span>
            <span class="leg__no">{stageWord} {i + 1}</span>
            <h3>{t(step.title, lang)}</h3>
            <p>{t(step.text, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .route {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem 1.6rem;
    position: relative;
  }

  @media (min-width: 900px) {
    .route { grid-template-columns: repeat(4, 1fr) }
  }

  .leg { position: relative; padding-top: 1.7rem }

  /* La línea de derrota pasa por los waypoints */
  .leg::before {
    content: "";
    position: absolute;
    top: .55rem;
    left: 0;
    right: 0;
    border-top: 2px dashed var(--course);
    opacity: .8;
  }

  .leg__pt {
    position: absolute;
    top: 0;
    left: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--course);
    border: 2px solid var(--water-2);
    box-shadow: 0 0 0 1px var(--course);
  }

  /* En columna (móvil) la línea baja en vertical */
  @media (max-width: 899px) {
    .leg::before { right: auto; bottom: -2.4rem; left: .5rem; top: 1.3rem; border-top: 0; border-left: 2px dashed var(--course) }
    .leg:last-child::before { display: none }
    .leg { padding-left: 2.2rem; padding-top: 0 }
    .leg__pt { top: .15rem }
  }

  .leg__no {
    display: block;
    font-size: .66rem;
    font-weight: 600;
    letter-spacing: .22em;
    color: var(--course);
    margin-bottom: .6rem;
  }

  .leg h3 { font-size: 1.05rem; margin-bottom: .55rem }
  .leg p { font-size: .87rem; color: var(--muted-strong) }
</style>
