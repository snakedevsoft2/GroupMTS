---
import { contact } from '@/data/contact';
import { site } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section" id="contacto">
  <div class="wrap">
    <div class="cta reveal">
      <h2 set:html={t(contact.titleHtml, lang)} />
      <p class="lede">{t(contact.lede, lang)}</p>
      <div class="cta-buttons">
        <a href={t(site.whatsapp, lang)} target="_blank" rel="noopener noreferrer" class="btn" data-magnetic>
          <span>{t(contact.buttons.whatsapp, lang)}</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.instagram, lang)}</span>
        </a>
        <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.facebook, lang)}</span>
        </a>
        <a href={t(site.mailto, lang)} class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.email, lang)}</span>
        </a>
      </div>
      <div class="contact-line">
        <a href={site.phoneHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"></path>
          </svg>{site.phoneDisplay}
        </a>
        <a href={t(site.mailto, lang)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3"></rect>
            <path d="m3 6 9 7 9-7"></path>
          </svg>{site.email}
        </a>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg><span>{t(contact.location, lang)}</span>
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg><span>{t(contact.hours, lang)}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* La recalada: panel de mar profundo con marco de carta */
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-s);
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 4rem);
    background: linear-gradient(160deg, var(--sea), var(--sea-2));
    border: 1px solid var(--sea-2);
    outline: 3px double var(--line-2);
    outline-offset: 5px;
    text-align: center;
  }

  .cta > :global(*) { position: relative }
  .cta h2 { color: var(--sea-ink) }
  .cta h2 :global(em) { color: var(--land) }
  .cta .lede { margin-inline: auto; color: var(--sea-muted) }

  .cta :global(.btn:not(.btn--ghost)) {
    background: var(--land);
    color: var(--sea-2);
    border-color: var(--land-2);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, .5);
  }

  .cta :global(.btn:not(.btn--ghost)):hover { background: var(--land-2) }
  .cta :global(.btn--ghost) { color: var(--sea-ink); border-color: rgba(220, 231, 237, .35) }
  .cta :global(.btn--ghost):hover { background: rgba(220, 231, 237, .12); border-color: var(--sea-ink) }

  .cta-buttons { display: flex; flex-wrap: wrap; gap: .85rem; justify-content: center; margin-top: 2.5rem }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 1.7rem;
    justify-content: center;
    margin-top: 2.8rem;
    padding-top: 2.1rem;
    border-top: 1px dashed rgba(220, 231, 237, .3);
    font-size: .85rem;
    color: var(--sea-muted);
  }

  .contact-line a, .contact-line > span { display: inline-flex; align-items: center; gap: .55rem; transition: color .3s }
  .contact-line a:hover { color: var(--sea-ink) }
  .contact-line svg { width: 1rem; height: 1rem; color: var(--land) }
</style>
