---
import { contact } from '@/data/contact';
import { site } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section" id="contacto">
  <div class="wrap">
    <div class="cta reveal">
      <span class="eyebrow" style="justify-content:center">{t(contact.eyebrow, lang)}</span>
      <h2 set:html={t(contact.titleHtml, lang)} />
      <p class="lede">{t(contact.lede, lang)}</p>
      <div class="cta-buttons">
        <a href={t(site.whatsapp, lang)} target="_blank" rel="noopener noreferrer" class="btn" data-magnetic>
          <span>{t(contact.buttons.whatsapp, lang)}</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.instagram, lang)}</span>
        </a>
        <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.facebook, lang)}</span>
        </a>
        <a href={t(site.mailto, lang)} class="btn btn--ghost" data-magnetic>
          <span>{t(contact.buttons.email, lang)}</span>
        </a>
      </div>
      <div class="contact-line">
        <a href={site.phoneHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"></path>
          </svg>{site.phoneDisplay}
        </a>
        <a href={t(site.mailto, lang)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3"></rect>
            <path d="m3 6 9 7 9-7"></path>
          </svg>{site.email}
        </a>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg><span>{t(contact.location, lang)}</span>
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg><span>{t(contact.hours, lang)}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-l);
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 4rem);
    background: linear-gradient(145deg, #071B2C 0%, #0A2E5C 52%, #06485E 100%);
    border: 0;
    text-align: center;
  }

  /* Color washes at the top of the card */
  .cta::before {
    content: "";
    position: absolute;
    inset: -30% -10% auto;
    height: 90%;
    background: radial-gradient(45% 60% at 28% 0%, rgba(var(--c2-rgb), .42), transparent 68%),
        radial-gradient(40% 55% at 82% 10%, rgba(var(--c3-rgb), .28), transparent 68%);
  }

  .cta > :global(*) { position: relative }
  .cta .eyebrow { color: var(--c2) }
  .cta .eyebrow::before { background: var(--c2) }
  .cta h2 { color: #fff }
  .cta h2 :global(em) { color: var(--c2) }
  .cta .lede { margin-inline: auto; color: rgba(255, 255, 255, .72) }

  .cta :global(.btn:not(.btn--ghost)) {
    background: #fff;
    background-image: none;
    color: var(--ink);
    box-shadow: 0 12px 30px -12px rgba(0, 0, 0, .6);
  }

  .cta :global(.btn:not(.btn--ghost)):hover { background: var(--c2); color: #04252B }
  .cta :global(.btn--ghost) { color: #fff; border-color: rgba(255, 255, 255, .3) }
  .cta :global(.btn--ghost):hover { background: #fff; color: var(--ink); border-color: #fff }

  .cta-buttons { display: flex; flex-wrap: wrap; gap: .85rem; justify-content: center; margin-top: 2.5rem }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 1.7rem;
    justify-content: center;
    margin-top: 2.8rem;
    padding-top: 2.1rem;
    border-top: 1px solid rgba(255, 255, 255, .15);
    font-size: .85rem;
    color: rgba(255, 255, 255, .72);
  }

  .contact-line a, .contact-line > span { display: inline-flex; align-items: center; gap: .55rem; transition: color .3s }
  .contact-line a:hover { color: #fff }
  .contact-line svg { width: 1rem; height: 1rem; color: var(--c2) }
</style>
