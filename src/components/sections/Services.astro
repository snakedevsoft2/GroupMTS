---
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import { services, servicesHead } from '@/data/services';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const zoneWord = lang === 'es' ? 'ZONA' : 'ZONE';
---

<section class="section section--tint" id="servicios">
  <div class="wrap">
    <div class="head">
      <h2 class="reveal" data-d="1" set:html={t(servicesHead.titleHtml, lang)} />
      <p class="lede reveal" data-d="2">{t(servicesHead.lede, lang)}</p>
    </div>
    <div class="zones">
      {
        services.map((s, i) => (
          <article class="zone reveal" data-d={i + 1}>
            <header class="zone__head">
              <span class="zone__no">{zoneWord} {i + 1}</span>
              <span class="zone__mark"><ServiceIcon icon={s.icon} /></span>
            </header>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.text, lang)}</p>
            <ul>
              {s.bullets.map((b) => (
                <li>{t(b, lang)}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Zonas de la carta: recuadros con marco doble, la zona 1 manda. */
  .zones { display: grid; gap: 1.4rem; grid-template-columns: 1fr }

  @media (min-width: 700px) {
    .zones { grid-template-columns: repeat(2, 1fr) }
  }

  @media (min-width: 1180px) {
    .zones { gap: 1.7rem }
  }

  /* Placa de club: filete de latón fino con paspartú */
  .zone {
    position: relative;
    padding: clamp(1.7rem, 2.6vw, 2.3rem);
    background: var(--card);
    border: 1px solid var(--line-2);
    outline: 1px solid var(--brass-soft);
    outline-offset: 5px;
    box-shadow: var(--shadow-s);
    transition: transform .45s var(--ease), box-shadow .45s var(--ease), border-color .3s, outline-color .3s;
  }

  .zone:hover {
    transform: translateY(-5px);
    border-color: var(--brass-deep);
    outline-color: var(--brass);
    box-shadow: var(--shadow-m);
  }

  .zone__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: .8rem;
    margin-bottom: 1.2rem;
  }

  .zone__no {
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .24em;
    color: var(--course-deep);
  }

  .zone__mark { color: var(--ink-2) }
  .zone__mark :global(svg) { width: 1.35rem; height: 1.35rem; display: block }

  .zone h3 { margin-bottom: .7rem }
  .zone p { color: var(--ink-2); font-size: .94rem }

  /* Notas de zona: guiones de anotación, no dots de colores */
  .zone ul {
    margin: 1.2rem 0 0;
    padding: 1.2rem 0 0;
    list-style: none;
    display: grid;
    gap: .5rem;
    border-top: 1px solid var(--line-soft);
  }

  .zone li { font-size: .85rem; color: var(--muted-strong); display: flex; gap: .6rem; align-items: baseline }
  .zone li::before { content: "—"; color: var(--brass-deep); flex: none }
</style>
