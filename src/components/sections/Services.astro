---
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import { services, servicesHead } from '@/data/services';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section section--tint" id="servicios">
  <div class="wrap">
    <div class="head">
      <h2 class="reveal" data-d="1" set:html={t(servicesHead.titleHtml, lang)} />
      <p class="lede reveal" data-d="2">{t(servicesHead.lede, lang)}</p>
    </div>
    <div class="grid-3">
      {
        services.map((s, i) => (
          <article class="card reveal" data-d={i + 1} data-spotlight data-tone={i + 1}>
            <div class="card__icon"><ServiceIcon icon={s.icon} /></div>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.text, lang)}</p>
            <ul>
              {s.bullets.map((b) => (
                <li>{t(b, lang)}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid-3 { display: grid; gap: 1.1rem; grid-template-columns: 1fr }

  @media (min-width: 560px) {
    .grid-3 { grid-template-columns: repeat(2, 1fr) }
  }

  @media (min-width: 1180px) {
    .grid-3 { grid-template-columns: repeat(4, 1fr) }
  }

  .card {
    --tone: var(--accent);
    --tone-rgb: var(--accent-rgb);
    position: relative;
    padding: clamp(1.9rem, 3vw, 2.6rem);
    border-radius: var(--r-m);
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    transition: transform .5s var(--ease), border-color .4s, box-shadow .5s var(--ease);
  }

  /* Spotlight following the mouse (--mx/--my set by cursor.ts) */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity .45s;
    pointer-events: none;
    background: radial-gradient(22rem 18rem at var(--mx, 50%) var(--my, 0%), rgba(var(--tone-rgb), .13), transparent 65%);
  }

  .card:hover { transform: translateY(-8px); border-color: rgba(var(--tone-rgb), .4); box-shadow: var(--shadow-m) }
  .card:hover::before { opacity: 1 }

  .card__icon {
    color: var(--tone);
    margin-bottom: 1.4rem;
    transition: transform .5s var(--ease);
  }

  .card:hover .card__icon { transform: translateY(-3px) }

  .card__icon :global(svg) { width: 1.9rem; height: 1.9rem }

  .card h3 { margin-bottom: .75rem }
  .card p { color: var(--ink-2); font-size: .94rem }

  .card ul {
    margin: 1.3rem 0 0;
    padding: 1.3rem 0 0;
    list-style: none;
    display: grid;
    gap: .5rem;
    border-top: 1px solid var(--line-soft);
  }

  .card li { font-size: .85rem; color: var(--muted); display: flex; gap: .6rem; align-items: baseline }

  .card li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tone);
    flex: none;
    transform: translateY(-2px);
  }
</style>
