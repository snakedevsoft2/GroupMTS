---
import { Picture } from 'astro:assets';
import { beforeAfter } from '@/data/gallery';
import { dicts, t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
const widths = [640, 1080, 1600, 2000];
const sizes = '(max-width: 1240px) 92vw, 1150px';
---

<section class="section" id="transformacion">
  <div class="wrap">
    <div class="head">
      <h2 class="reveal" data-d="1" set:html={t(beforeAfter.titleHtml, lang)} />
      <p class="lede reveal" data-d="2">{t(beforeAfter.lede, lang)}</p>
    </div>
    <div class="ba reveal mask" data-d="1" id="ba" style="--pos:52%">
      <Picture
        src={beforeAfter.after.img}
        class="ba__img"
        alt={t(beforeAfter.after.alt, lang)}
        formats={['avif', 'webp']}
        {widths}
        {sizes}
        loading="lazy"
      />
      <Picture
        src={beforeAfter.before.img}
        class="ba__img ba__top"
        alt={t(beforeAfter.before.alt, lang)}
        formats={['avif', 'webp']}
        {widths}
        {sizes}
        loading="lazy"
      />
      <span class="ba__tag ba__tag--l">{dict.before}</span>
      <span class="ba__tag ba__tag--r">{dict.after}</span>
      <input type="range" min="0" max="100" value="52" id="baRange" aria-label={dict.baAria} aria-valuetext="52%" />
      <div class="ba__handle">
        <div class="ba__knob">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 6-5 6 5 6M15 6l5 6-5 6"></path>
          </svg>
        </div>
      </div>
    </div>
    <p class="ba__hint reveal">{dict.baHint}</p>
  </div>
</section>

<style>
  .ba {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    border: 1px solid var(--line-2);
    outline: 1px solid var(--brass-soft);
    outline-offset: 5px;
    box-shadow: var(--shadow-l);
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    background: var(--water-2);
  }

  @media (max-width: 640px) {
    .ba { aspect-ratio: 4/5 }
  }

  .ba :global(.ba__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover }
  .ba :global(.ba__top) { clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0) }

  /* Rótulos de carta: rectangulares, tinta sobre papel */
  .ba__tag {
    position: absolute;
    bottom: 1.1rem;
    z-index: 3;
    padding: .45rem 1rem;
    border-radius: var(--r-s);
    background: rgba(246, 248, 250, .94);
    border: 1px solid var(--line-2);
    font-size: .68rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink);
  }

  .ba__tag--l { left: 1.1rem }
  .ba__tag--r { right: 1.1rem; background: var(--course); color: #FDF6F1; border-color: var(--course-deep) }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    z-index: 4;
    width: 0;
    border-left: 2px solid var(--brass);
    transform: translateX(-1px);
    pointer-events: none;
  }

  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3.3rem;
    height: 3.3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--card);
    border: 1px solid var(--course);
    color: var(--course);
    box-shadow: 0 6px 22px rgba(34, 52, 60, .28);
  }

  .ba__knob svg { width: 1.3rem; height: 1.3rem }

  .ba input[type='range'] {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    opacity: 0;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
  }

  .ba__hint { margin-top: 1.2rem; font-size: .78rem; color: var(--muted); text-align: center; letter-spacing: .08em }
</style>

<script>
  /* Before/after comparator: pointer drag plus keyboard control */
  const ba = document.getElementById('ba');
  const range = document.getElementById('baRange') as HTMLInputElement | null;
  if (ba && range) {
    const setPos = (v: number): void => {
      const clamped = Math.max(0, Math.min(100, v));
      ba.style.setProperty('--pos', `${clamped}%`);
      range.value = String(clamped);
      range.setAttribute('aria-valuetext', `${Math.round(clamped)}%`);
    };
    range.addEventListener('input', () => setPos(parseFloat(range.value)));

    let dragging = false;
    const fromEvent = (e: PointerEvent): void => {
      const r = ba.getBoundingClientRect();
      setPos(((e.clientX - r.left) / r.width) * 100);
    };
    ba.addEventListener('pointerdown', (e) => {
      dragging = true;
      ba.setPointerCapture(e.pointerId);
      fromEvent(e);
    });
    ba.addEventListener('pointermove', (e) => {
      if (dragging) fromEvent(e);
    });
    for (const ev of ['pointerup', 'pointercancel'] as const) {
      ba.addEventListener(ev, () => { dragging = false; });
    }
  }
</script>
