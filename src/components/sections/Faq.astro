---
import { faqs, faqsHead } from '@/data/faqs';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="section section--tint">
  <div class="wrap">
    <div class="head" style="text-align:center;margin-inline:auto">
      <span class="eyebrow reveal" style="justify-content:center">{t(faqsHead.eyebrow, lang)}</span>
      <h2 class="reveal" data-d="1" set:html={t(faqsHead.titleHtml, lang)} />
    </div>
    <div class="faq reveal" data-d="1">
      {
        faqs.map((faq, i) => (
          <details open={i === 0}>
            <summary>{t(faq.q, lang)}</summary>
            <div class="a">{t(faq.a, lang)}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { max-width: 52rem; margin-inline: auto }
  .faq details { border-bottom: 1px solid var(--line) }

  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 1.5rem 3rem 1.5rem 0;
    position: relative;
    font-family: var(--f-display);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--ink);
    transition: color .3s;
  }

  .faq summary::-webkit-details-marker { display: none }

  /* Chevron rotates when open */
  .faq summary::after {
    content: "";
    position: absolute;
    right: .4rem;
    top: 50%;
    width: 11px;
    height: 11px;
    border-right: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: translateY(-70%) rotate(45deg);
    transition: transform .35s var(--ease);
  }

  .faq summary:hover, .faq details[open] summary { color: var(--accent) }
  .faq details[open] summary::after { transform: translateY(-20%) rotate(-135deg) }

  .faq .a { padding: 0 2rem 1.7rem 0; color: var(--ink-2); font-size: .94rem }
</style>
