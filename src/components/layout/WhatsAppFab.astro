---
/* FAB de WhatsApp (ref. dlpbasculas): el círculo verde que todo el mundo
   reconoce, con el logo real. Aparece tras el primer viewport y se oculta
   sobre el footer, que ya repite el contacto. */
import { site } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a class="wa" href={t(site.whatsapp, lang)} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"
    ></path>
  </svg>
</a>

<style>
  .wa {
    position: fixed;
    right: max(1.1rem, env(safe-area-inset-right));
    bottom: max(1.1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    box-shadow: 0 4px 14px rgba(11, 61, 31, .35);
    scale: 0;
    opacity: 0;
    transition: scale .35s var(--ease), opacity .35s var(--ease), background .3s;
  }

  .wa:hover, .wa:focus-visible { background: #1FAF54 }
  .wa:hover svg { animation: wa-ring .5s cubic-bezier(.16, 1, .3, 1) }
  .wa.on { scale: 1; opacity: 1 }

  /* Doble pulso al aparecer — luego silencio */
  .wa.on::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25D366;
    animation: wa-pulse 2.2s cubic-bezier(.16, 1, .3, 1) .5s 2;
    opacity: 0;
    pointer-events: none;
  }

  @keyframes wa-pulse {
    0% { opacity: .7; transform: scale(1) }
    100% { opacity: 0; transform: scale(1.55) }
  }

  @keyframes wa-ring {
    0%, 100% { transform: rotate(0) }
    30% { transform: rotate(-12deg) }
    60% { transform: rotate(9deg) }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa.on::after, .wa:hover svg { animation: none }
  }
</style>

<script>
  /* Visible solo entre el primer viewport y el footer. */
  const el = document.querySelector('.wa');
  const footer = document.querySelector('footer');
  if (el && footer) {
    let footerVisible = false;
    const apply = (): void => el.classList.toggle('on', window.scrollY > 420 && !footerVisible);
    new IntersectionObserver((entries) => {
      footerVisible = entries[0]?.isIntersecting ?? false;
      apply();
    }).observe(footer);
    apply();
    window.addEventListener('scroll', apply, { passive: true });
  }
</script>
