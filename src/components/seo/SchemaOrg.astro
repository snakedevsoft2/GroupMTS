---
import logo from '@/assets/brand/logo.png';
import { faqs } from '@/data/faqs';
import { meta, site } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = Astro.site!;

/* Owner-confirmed data only (see PRODUCT.md). */
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', base).href,
  name: 'GroupMTS - Marine Tops',
  legalName: site.legalName,
  description: t(meta.schemaDescription, lang),
  url: new URL(lang === 'es' ? '/' : '/en/', base).href,
  image: new URL(logo.src, base).href,
  telephone: site.phoneSchema,
  email: site.email,
  areaServed: 'Puerto Rico',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  sameAs: [site.instagram, site.facebook],
  openingHours: site.openingHoursSchema,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', base).href,
  url: base.href,
  name: 'GroupMTS - Marine Tops',
  inLanguage: lang === 'es' ? 'es-PR' : 'en-US',
  publisher: { '@id': new URL('/#business', base).href },
};

/* Generated from src/data/faqs.ts — never duplicated by hand. */
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: t(faq.q, lang),
    acceptedAnswer: { '@type': 'Answer', text: t(faq.a, lang) },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(business)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage)} />
