---
import { dicts, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = dicts[lang];
---

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label={dict.lightboxAria}>
  <button class="lb__x" id="lbClose" aria-label={dict.close}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
  <button class="lb__nav prev" id="lbPrev" aria-label={dict.prev}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>
  <button class="lb__nav next" id="lbNext" aria-label={dict.next}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>
  <figure>
    <img id="lbImg" alt="" />
    <figcaption id="lbCap"></figcaption>
  </figure>
  <span class="lb__count" id="lbCount"></span>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 180;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(10, 24, 35, .94);
    backdrop-filter: blur(12px);
    opacity: 0;
    visibility: hidden;
    transition: opacity .4s var(--ease), visibility .4s;
  }

  .lb.open { opacity: 1; visibility: visible }

  .lb figure { margin: 0; max-width: min(1100px, 92vw); width: 100%; display: grid; justify-items: center; gap: 1.1rem }

  .lb img {
    max-height: 78svh;
    width: auto;
    border-radius: var(--r-m);
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, .8);
    transform: scale(.96);
    transition: transform .5s var(--ease);
  }

  .lb.open img { transform: none }

  .lb figcaption { font-size: .76rem; letter-spacing: .18em; text-transform: uppercase; color: rgba(255, 255, 255, .7) }

  .lb__x, .lb__nav {
    position: absolute;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, .22);
    background: rgba(255, 255, 255, .08);
    color: #fff;
    transition: .3s var(--ease);
  }

  .lb__x:hover, .lb__nav:hover { background: #fff; color: var(--ink); border-color: #fff }
  .lb__x { top: clamp(1rem, 3vw, 2rem); right: clamp(1rem, 3vw, 2rem) }
  .lb__nav { top: 50%; transform: translateY(-50%) }
  .lb__nav.prev { left: clamp(.6rem, 2vw, 2rem) }
  .lb__nav.next { right: clamp(.6rem, 2vw, 2rem) }
  .lb__nav:hover { transform: translateY(-50%) scale(1.06) }
  .lb svg { width: 1.2rem; height: 1.2rem }

  .lb__count {
    position: absolute;
    bottom: clamp(1rem, 3vw, 2rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: .73rem;
    letter-spacing: .22em;
    color: rgba(255, 255, 255, .55);
  }

  @media (max-width: 620px) {
    .lb__nav { width: 2.6rem; height: 2.6rem }
  }
</style>
