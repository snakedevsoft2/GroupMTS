---
import BaseLayout from './BaseLayout.astro';
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFab from '@/components/layout/WhatsAppFab.astro';
import Hero from '@/components/sections/Hero.astro';
import Marquee from '@/components/sections/Marquee.astro';
import Services from '@/components/sections/Services.astro';
import BeforeAfter from '@/components/sections/BeforeAfter.astro';
import Process from '@/components/sections/Process.astro';
import Gallery from '@/components/sections/Gallery.astro';
import VideoBand from '@/components/sections/VideoBand.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Faq from '@/components/sections/Faq.astro';
import Contact from '@/components/sections/Contact.astro';
import { meta } from '@/data/site';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout
  {lang}
  title={t(meta.title, lang)}
  description={t(meta.description, lang)}
  ogTitle={t(meta.ogTitle, lang)}
  ogDescription={t(meta.ogDescription, lang)}
>
  <Nav {lang} />
  <Hero {lang} />
  <Marquee {lang} />
  <main id="main">
    <Services {lang} />
    <BeforeAfter {lang} />
    <Process {lang} />
    <Gallery {lang} />
    <VideoBand {lang} />
    <Testimonials {lang} />
    <Faq {lang} />
    <Contact {lang} />
  </main>
  <Footer {lang} />
  <WhatsAppFab {lang} />
</BaseLayout>
