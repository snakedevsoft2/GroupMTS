---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import caslon400 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import caslon700 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-700-normal.woff2?url';
import caslonItalic from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-italic.woff2?url';
import ps400 from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import ps600 from '@fontsource/public-sans/files/public-sans-latin-600-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];

/* @font-face inline — un request CSS menos; swap + fallbacks ajustados (base.css). */
const fontFaces = [
  ['Libre Caslon Text', 'normal', 400, caslon400],
  ['Libre Caslon Text', 'normal', 700, caslon700],
  ['Libre Caslon Text', 'italic', 400, caslonItalic],
  ['Public Sans', 'normal', 400, ps400],
  ['Public Sans', 'normal', 600, ps600],
]
  .map(
    ([family, style, weight, url]) =>
      `@font-face{font-family:"${family}";font-style:${style};font-weight:${weight};font-display:swap;src:url(${url}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2013-2014,U+2018-2019,U+201C-201D,U+2026,U+2212}`,
  )
  .join('');

/* Contrato de dirección (impeccable new-work §5) — sobrevive el build como
   primer hijo del body. */
const contract = `
THESIS: El taller como club nautico: navy de blazer, gallardetes, laton
grabado. Pertenencia y tradicion — donde los que saben llevan su bote.
Rechaza el grid de cards con iconos y el hero de stock.
OWN-WORLD: navy #0B1C2C, cubierta clara #F6F8FA, laton #C9A96A, burdeos de
gallardete #7A1F2B. Libre Caslon (versalitas espaciadas, italica) + Public
Sans. Placas con filete de laton, gallardete propio (Burgee.astro), palmares
grabado, marcos de cuadro, esquinas rectas.
STORY: el visitante entra a la sede, ve el palmares y el trabajo real colgado,
y pide su cotizacion por WhatsApp como quien firma el libro del club.
FIRST VIEWPORT: salon navy: placa con gallardete y versalitas, titular Caslon
claro, el video real enmarcado en laton como cuadro de sede, CTA laton;
palmares de cifras reales abajo con filetes.
FORM: Club Nautico — candidato 5 de la mano 3 (assigned); seed 6c623b64.
FINISH: unreviewed and undocumented is unfinished; this build ends with the
finish review, the verdict, DESIGN.md, and every shipping raster carrying its
provenance.`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1C2C" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={caslon400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={caslon700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={ps400} crossorigin />
    <style set:html={fontFaces}></style>
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={`<!--${contract}-->`} />
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
