---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import splineLatin from '@fontsource/spline-sans-mono/files/spline-sans-mono-latin-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];

/* @font-face inline — un request CSS menos; swap + fallbacks ajustados (base.css). */
const fontFaces =
  `@font-face{font-family:"Archivo Variable";font-style:normal;font-weight:100 900;font-stretch:62.5% 125%;font-display:swap;src:url(${archivoLatin}) format("woff2-variations")}` +
  `@font-face{font-family:"Spline Sans Mono";font-style:normal;font-weight:400;font-display:swap;src:url(${splineLatin}) format("woff2")}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FCFBF9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={splineLatin} crossorigin />
    <style set:html={fontFaces}></style>
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true">
      {/* Lancha caricatura de perfil: banderín, parabrisas, franja y olas.
          El JS la voltea según el rumbo y la inclina con la velocidad. */}
      <svg viewBox="0 0 48 32" width="48" height="34">
        <g>
          <path d="M6 28.5 Q 10 26.5 14 28.5 Q 18 30.5 22 28.5" fill="none" stroke="#7db4e6" stroke-width="1.7" stroke-linecap="round"></path>
          <path d="M27 29.5 Q 31 27.5 35 29.5 Q 39 31.5 43 29.5" fill="none" stroke="#7db4e6" stroke-width="1.7" stroke-linecap="round"></path>
          <line x1="8.6" y1="16" x2="8.6" y2="9.4" stroke="var(--accent)" stroke-width="1.1" stroke-linecap="round"></line>
          <path d="M8.6 9.4 L14 11 L8.6 12.8 Z" fill="var(--accent)"></path>
          <path
            d="M5.5 16.5 L36 16.5 C 39.5 16.2 42.6 14.6 45 11.8 C 45.8 15.4 45 19.6 42.6 22.4 C 40.2 25.2 35.4 26.4 30 26.4 L 12 26.4 C 8 26.4 5.5 23.8 5.5 20.2 Z"
            fill="#fff"
            stroke="var(--accent)"
            stroke-width="1.6"
            stroke-linejoin="round"
          ></path>
          <path d="M7 21.6 L 41.5 21.6" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round"></path>
          <path d="M22.5 16.5 L 25.5 9.8 L 31.5 9.8 L 33.6 16.5 Z" fill="rgba(125,180,230,.45)" stroke="var(--accent)" stroke-width="1.3" stroke-linejoin="round"></path>
        </g>
      </svg>
    </div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
