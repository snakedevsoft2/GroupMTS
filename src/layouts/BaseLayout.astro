---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FCFBF9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesItalic} crossorigin />
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
