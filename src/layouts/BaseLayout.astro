---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import caslon400 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import caslon700 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-700-normal.woff2?url';
import caslonItalic from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-italic.woff2?url';
import ps400 from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import ps600 from '@fontsource/public-sans/files/public-sans-latin-600-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];

/* @font-face inline — un request CSS menos; swap + fallbacks ajustados (base.css). */
const fontFaces = [
  ['Libre Caslon Text', 'normal', 400, caslon400],
  ['Libre Caslon Text', 'normal', 700, caslon700],
  ['Libre Caslon Text', 'italic', 400, caslonItalic],
  ['Public Sans', 'normal', 400, ps400],
  ['Public Sans', 'normal', 600, ps600],
]
  .map(
    ([family, style, weight, url]) =>
      `@font-face{font-family:"${family}";font-style:${style};font-weight:${weight};font-display:swap;src:url(${url}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2013-2014,U+2018-2019,U+201C-201D,U+2026,U+2212}`,
  )
  .join('');

/* Contrato de dirección (impeccable new-work §5) — sobrevive el build como
   primer hijo del body. */
const contract = `
THESIS: El sitio ES una carta nautica de Puerto Rico: el visitante traza un
rumbo desde su problema hasta el puerto (WhatsApp). Rechaza el hero fotografico
generico de marine-services.
OWN-WORLD: agua de carta #E3ECEE (nunca crema), costa buff #E2D3A0, tinta
#22343C, rumbo rojo #C2402A, marino #1E3A5F. Libre Caslon (grabado, caps
espaciadas, italica para aguas) + Public Sans. Batimetria, rosa de compas,
sondas, recuadros inset, esquinas casi rectas.
STORY: un capitan reconoce su carta, ve que un solo taller cubre todo el bote,
sigue el rumbo rojo y manda fotos por WhatsApp.
FIRST VIEWPORT: carta de la costa: titulo de carta arriba-izq (Caslon caps),
costa buff a la derecha, sondas en el agua, rumbo rojo discontinuo que baja al
CTA WhatsApp (waypoint rojo). Video real como inset de reconocimiento.
FORM: Carta Nautica de PR — candidato 1 de la mano 2 (pick); seed 6c623b64.
FINISH: unreviewed and undocumented is unfinished; this build ends with the
finish review, the verdict, DESIGN.md, and every shipping raster carrying its
provenance.`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#E3ECEE" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={caslon400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={caslon700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={ps400} crossorigin />
    <style set:html={fontFaces}></style>
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={`<!--${contract}-->`} />
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
