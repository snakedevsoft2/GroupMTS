---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import splineLatin from '@fontsource/spline-sans-mono/files/spline-sans-mono-latin-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];

/* @font-face inline — un request CSS menos; swap + fallbacks ajustados (base.css). */
const fontFaces =
  `@font-face{font-family:"Archivo Variable";font-style:normal;font-weight:100 900;font-stretch:62.5% 125%;font-display:swap;src:url(${archivoLatin}) format("woff2-variations")}` +
  `@font-face{font-family:"Spline Sans Mono";font-style:normal;font-weight:400;font-display:swap;src:url(${splineLatin}) format("woff2")}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FCFBF9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={splineLatin} crossorigin />
    <style set:html={fontFaces}></style>
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true">
      {/* Yate en planta: navega hacia donde se mueve el mouse */}
      <svg viewBox="0 0 24 44" width="24" height="44">
        <path
          d="M12 1 C 17 9, 19 18, 19 27 C 19 36, 16 41, 12 42 C 8 41, 5 36, 5 27 C 5 18, 7 9, 12 1 Z"
          fill="rgba(255,255,255,.85)"
          stroke="var(--accent)"
          stroke-width="1.6"
        ></path>
        <path d="M12 8 C 15 14, 16 20, 16 26 C 16 32, 14 36, 12 37 C 10 36, 8 32, 8 26 C 8 20, 9 14, 12 8 Z" fill="rgba(10,91,196,.18)"></path>
        <circle cx="12" cy="30" r="1.6" fill="var(--accent)"></circle>
      </svg>
    </div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
