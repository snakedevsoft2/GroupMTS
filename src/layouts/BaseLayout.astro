---
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/buttons.css';
import '@/styles/chrome.css';
import '@/styles/motion.css';
import Seo from '@/components/seo/Seo.astro';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import { dicts, type Lang } from '@/i18n';
import interLatin from '@/assets/fonts/inter-var.woff2?url';
import frauncesLatin from '@/assets/fonts/fraunces-var.woff2?url';
import frauncesItalic from '@/assets/fonts/fraunces-var-italic.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { lang, title, description, ogTitle, ogDescription } = Astro.props;
const dict = dicts[lang];

/* @font-face inline — un request CSS menos; swap + fallbacks ajustados (base.css). */
const fontFaces = [
  ['Inter Variable', 'normal', interLatin],
  ['Fraunces Variable', 'normal', frauncesLatin],
  ['Fraunces Variable', 'italic', frauncesItalic],
]
  .map(
    ([family, style, url]) =>
      `@font-face{font-family:"${family}";font-style:${style};font-weight:100 900;font-display:swap;src:url(${url}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+2013-2014,U+2018-2019,U+201C-201D,U+2026,U+2212}`,
  )
  .join('');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FCFBF9" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesItalic} crossorigin />
    <style set:html={fontFaces}></style>
    <Seo {lang} {title} {description} {ogTitle} {ogDescription} />
    <SchemaOrg {lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{dict.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>
