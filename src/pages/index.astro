---
import BaseLayout from '../layouts/BaseLayout.astro';
import { meta } from '../data/site';
import { t, type Lang } from '../i18n';

const lang: Lang = 'es';
---

<BaseLayout
  {lang}
  title={t(meta.title, lang)}
  description={t(meta.description, lang)}
  ogTitle={t(meta.ogTitle, lang)}
  ogDescription={t(meta.ogDescription, lang)}
>
  <main id="main"></main>
</BaseLayout>
