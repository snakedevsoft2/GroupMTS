---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Services from '../components/Services.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import VideoBand from '../components/VideoBand.astro';
import Testimonials from '../components/Testimonials.astro';
import { meta } from '../data/site';
import { t, type Lang } from '../i18n';

const lang: Lang = 'es';
---

<BaseLayout
  {lang}
  title={t(meta.title, lang)}
  description={t(meta.description, lang)}
  ogTitle={t(meta.ogTitle, lang)}
  ogDescription={t(meta.ogDescription, lang)}
>
  <Nav {lang} />
  <Hero {lang} />
  <Marquee {lang} />
  <main id="main">
    <Services {lang} />
    <BeforeAfter {lang} />
    <Process {lang} />
    <Gallery {lang} />
    <VideoBand {lang} />
    <Testimonials {lang} />
  </main>
</BaseLayout>
